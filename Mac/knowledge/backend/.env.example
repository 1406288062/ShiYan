APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=1440
MAX_UPLOAD_BYTES=52428800

# 默认使用本地 Qwen Embedding；豆包仅作为可手动切换的线上备用实现。
EMBEDDING_PROVIDER=qwen
DOUBAO_EM_API_KEY=
DOUBAO_EM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_EM_MODEL=doubao-embedding-vision-251215

# 本地 Qwen3-Embedding-0.6B。模型文件放在 FastAPI-agent/models/ 下，不提交到 GitHub。
LOCAL_EMBEDDING_MODEL=models/Qwen3-Embedding-0.6B
# auto 会优先使用 Apple Silicon MPS，否则使用 CPU；也可明确填写 mps 或 cpu。
LOCAL_EMBEDDING_DEVICE=auto
LOCAL_EMBEDDING_BATCH_SIZE=4
LOCAL_EMBEDDING_MAX_LENGTH=8192
LOCAL_EMBEDDING_QUERY_INSTRUCTION=Given a user question, retrieve relevant passages from a Chinese PDF knowledge base that answer the question

# LLM 优先走共享入口 HTTPS:443 -> Nginx -> 服务器 127.0.0.1:4320；URL 路径区分业务。留空时回退本机 Codex SDK / CLI。
CODEX_GATEWAY_URL=
CODEX_GATEWAY_TOKEN=
CODEX_GATEWAY_CA_CERT=certs/codex-server.crt
CODEX_NODE_BINARY=node
CODEX_BRIDGE_PATH=codex-bridge/bridge.mjs
# 本地 fallback 可留空并复用 codex login；容器/服务器可配置 API Key。
CODEX_API_KEY=
# 留空时使用 ~/.codex/config.toml 当前模型；也可以显式指定 Codex 可用模型。
CODEX_MODEL=
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=180

# 普通文字页本地解析；扫描、表格、图表或乱码页按需调用 Codex 视觉能力。
PDF_VISION_MIN_TEXT_CHARS=80
PDF_VISION_RENDER_DPI=132
PDF_VISION_MAX_PAGES=200
PDF_VISION_WORKERS=9
KNOWLEDGE_WORKERS=9
KNOWLEDGE_CONTEXT_MAX_CHARS=500000

# 默认只记录模型、状态和耗时，不保存可能包含原文或向量的响应正文。
MODEL_RESPONSE_LOG_BODY=false
MODEL_RESPONSE_LOG_MAX_CHARS=4000

# Optional SearXNG-compatible web search endpoint.
SEARCH_API_URL=
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Optional read-only Sales integration service (uvicorn retrieval_app:app --app-dir src --port 8002)
RETRIEVAL_API_KEY=
RETRIEVAL_ALLOWED_KB_IDS=
RETRIEVAL_MAX_DISTANCE=0.45
